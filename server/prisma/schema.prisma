generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  AUTHORITY
  SUPER_ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Visibility {
  PUBLIC
  PERSONAL
}

enum Status {
  CREATED
  ASSIGNED
  IN_PROGRESS
  UNDER_REVIEW
  RESOLVED
  CLOSED
  ESCALATED
}

enum VoteType {
  UP
  DOWN
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(STUDENT)
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  complaints      Complaint[]      @relation("UserComplaints")
  assignedTickets Complaint[]      @relation("AssignedTickets")
  comments        Comment[]
  votes           Vote[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  users       User[]
  complaints  Complaint[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Complaint {
  id              String          @id @default(uuid())
  hashId          String          @unique // Hash for blockchain audit
  title           String
  description     String
  category        String
  severity        Severity
  visibility      Visibility
  status          Status          @default(CREATED)
  
  // Relations
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  userId          String
  user            User            @relation("UserComplaints", fields: [userId], references: [id])
  assignedToId    String?
  assignedTo      User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  // SLA Tracking
  slaDeadline     DateTime?
  slaBreached     Boolean         @default(false)
  respondedAt     DateTime?
  resolvedAt      DateTime?
  
  // Artifacts
  ipfsHash        String?
  attachmentUrl   String?
  resolutionProof String?
  txHash          String?         // Latest blockchain tx hash
  
  // Sub-resources
  votes           Vote[]
  comments        Comment[]
  activityLogs    ActivityLog[]
  feedback        Feedback?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Comment {
  id            String    @id @default(uuid())
  text          String
  attachmentUrl String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  createdAt     DateTime  @default(now())
}

model Vote {
  id          String    @id @default(uuid())
  type        VoteType
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, complaintId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  action      String   // TICKET_CREATED, STATUS_CHANGE, ASSIGNMENT, COMMENT_ADDED, SLA_BREACH
  oldValue    String?
  newValue    String?
  details     String?  @db.Text
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  timestamp   DateTime @default(now())
}

model Feedback {
  id          String    @id @default(uuid())
  rating      Int       // 1-5
  comment     String?
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // INFO, WARNING, SUCCESS, DANGER
  message   String
  link      String?  
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
